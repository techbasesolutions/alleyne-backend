# Server
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://alleyne-backend.onrender.com

# Strapi secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Database (Render PostgreSQL — auto-injected via render.yaml fromDatabase refs)
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=alleyne
DATABASE_USERNAME=alleyne
DATABASE_PASSWORD=
DATABASE_SSL=true

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@alleyne.com
