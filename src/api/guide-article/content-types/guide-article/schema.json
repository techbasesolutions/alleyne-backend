{
  "kind": "collectionType",
  "collectionName": "guide_articles",
  "info": {
    "singularName": "guide-article",
    "pluralName": "guide-articles",
    "displayName": "Guide Article"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title":           { "type": "string",   "required": true },
    "slug":            { "type": "uid",      "targetField": "title", "required": true },
    "excerpt":         { "type": "text",     "required": true },
    "body":            { "type": "richtext", "required": true },
    "heroImage":       { "type": "media",    "multiple": false, "allowedTypes": ["images"] },
    "category": {
      "type": "enumeration",
      "enum": [
        "macroeconomics",
        "finance",
        "legal",
        "geography",
        "costs_and_tax",
        "ownership_structure",
        "residency",
        "maintenance",
        "sustainability"
      ]
    },
    "readTimeMinutes": { "type": "integer" },
    "sortOrder":       { "type": "integer" },
    "metaTitle":       { "type": "string" },
    "metaDescription": { "type": "text" }
  }
}
